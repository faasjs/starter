{
  "extends": "faasjs/tsconfig.build",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "src/.faasjs/**/*.d.ts",
    "server.ts",
    "types.d.ts",
    "vite.config.ts",
    "vitest.*.setup.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules"]
}
