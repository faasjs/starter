{
  "extends": "./node_modules/@faasjs/types/tsconfig/build.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "server.ts",
    "vite.config.ts",
    "vitest.*.setup.ts"
  ],
  "exclude": [
    "coverage",
    "dist",
    "node_modules"
  ]
}